<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/palette_dark_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/palette_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="-40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivIconoDetalle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/detalle_info_label"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/palette_accent"
                android:background="@drawable/circle_background"
                android:padding="16dp"
                android:elevation="6dp"/>

            <!-- Card 1: Información General -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/palette_card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_info_label"
                        android:textStyle="bold"
                        android:textColor="@color/palette_accent"
                        android:layout_marginBottom="8dp"/>

                    <TableLayout
                        android:id="@+id/tlDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1">

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detalle_nombre_col"
                                android:textStyle="bold"
                                android:textColor="@color/palette_accent" />
                            <TextView
                                android:id="@+id/tvDetalleNombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:textColor="@color/palette_cream_text"
                                tools:text="Nombre de la tarea" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detalle_categoria_col"
                                android:textStyle="bold"
                                android:textColor="@color/palette_accent" />
                            <TextView
                                android:id="@+id/tvDetalleCategoria"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:textColor="@color/palette_cream_text"
                                tools:text="Trabajo" />
                        </TableRow>

                        <TableRow android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detalle_prioridad_col"
                                android:textStyle="bold"
                                android:textColor="@color/palette_accent" />
                            <TextView
                                android:id="@+id/tvDetallePrioridad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:textColor="@color/palette_cream_text"
                                tools:text="Alta" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detalle_estado_col"
                                android:textStyle="bold"
                                android:textColor="@color/palette_accent" />
                            <TextView
                                android:id="@+id/tvDetalleEstado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="8dp"
                                android:textColor="@color/palette_cream_text"
                                tools:text="Pendiente" />
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Avance e Importancia -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/palette_card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_cumplimiento_label"
                        android:textStyle="bold"
                        android:textColor="@color/palette_accent"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detalle_importancia_col"
                            android:textColor="@color/palette_cream_text"
                            android:textStyle="bold"/>

                        <RatingBar
                            android:id="@+id/rbDetalleImportancia"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressTint="@color/star_yellow"
                            android:stepSize="1.0" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbAvance"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:progressTint="@color/palette_accent"
                        android:max="100" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_sw_finalizar"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="center_horizontal"
                        android:textColor="@color/palette_cream_text"
                        app:thumbTint="@color/palette_accent"
                        app:trackTint="@color/palette_primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Checklist de Subtareas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/palette_card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_subtareas_label"
                        android:textStyle="bold"
                        android:textColor="@color/palette_accent"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/llSubtareasChecklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Botones de Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/palette_dark_bg">

        <Button
            android:id="@+id/btnEditar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_editar"
            android:backgroundTint="@color/palette_primary"
            android:textColor="@color/palette_cream_text"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_eliminar"
            android:backgroundTint="@color/cancel_red"
            android:textColor="@color/palette_cream_text" />
    </LinearLayout>

</LinearLayout>
